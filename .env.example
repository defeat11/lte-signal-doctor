# عنوان بوابة المودم على شبكتك المحلية — نفس العنوان الذي تفتح به صفحة إدارة المودم في المتصفح
MODEM_IP=

# كلمة مرور صفحة إدارة المودم (المستخدم admin يُملأ تلقائياً إن وُجد حقل له)
MODEM_PASSWORD=

# اختياري: توكن يطلبه الخادم من أي جهاز على الشبكة قبل عرض اللوحة
DASHBOARD_TOKEN=

# اختياري: مفتاح Gemini API لرأي الخبير المتقدم (بدونه يعمل محرك القواعد المحلي)
GEMINI_API_KEY=

# اختياري: أمر CLI لنموذج ذكاء اصطناعي يشغّل «طبيب الشبكة» — يستقبل البرومت كوسيطة أخيرة ويطبع الرد
# مثال: AI_DOCTOR_CLI=gemini -p
AI_DOCTOR_CLI=

# اختياري: منفذ لوحة القياسات
DASHBOARD_PORT=8000
